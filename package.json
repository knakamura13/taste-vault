{
  "name": "taste-vault",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "start": "node scripts/start.js",
    "start:local": "HOST=127.0.0.1 node scripts/start.js",
    "db:migrate": "node scripts/migrate.js",
    "taste": "node scripts/taste.js",
    "capture:worker": "node scripts/capture-worker.js",
    "test:trial": "node tests/trial.mjs",
    "test:auth": "node tests/auth.mjs",
    "test:capture": "node tests/capture.mjs",
    "test:intake": "node tests/intake-recovery.mjs",
    "test:interruption": "node tests/intake-interruption.mjs",
    "start:container": "node scripts/serve.js",
    "test:container": "node tests/container.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/pg": "^8.23.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5"
  }
}
